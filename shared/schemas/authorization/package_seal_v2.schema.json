{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qpathformer.org/schemas/authorization/package_seal_v2.schema.json",
  "title": "Q-Pathformer v2 Training Package Seal",
  "description": "Complete package inventory, deterministic Merkle root, and Ed25519 signature for a governed training package.",
  "type": "object",
  "required": [
    "seal_schema_version",
    "seal_id",
    "created_at_utc",
    "package_binding",
    "inventory",
    "merkle",
    "signature"
  ],
  "properties": {
    "seal_schema_version": {
      "const": "qpath_package_seal_v2.0"
    },
    "seal_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "package_binding": {
      "type": "object",
      "required": ["dataset_version", "registry_entry_id"],
      "properties": {
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "registry_entry_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "required": ["algorithm", "file_count", "entries"],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "merkle": {
      "type": "object",
      "required": ["algorithm", "root_sha256"],
      "properties": {
        "algorithm": {
          "const": "qpath-merkle-sha256-v1"
        },
        "root_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "canonicalization",
        "key_id",
        "public_key_sha256",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "canonicalization": {
          "const": "qpath-json-sort-keys-v1"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "public_key_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
